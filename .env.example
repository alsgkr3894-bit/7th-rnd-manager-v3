DATABASE_URL="postgresql://rnd_app:CHANGE_ME@127.0.0.1:5432/rnd_manager"
APP_ENV="development"

# 사내 LAN의 다른 PC에서 접속을 허용할지. "1" 일 때만 API가 RFC1918 사설 대역
# (10/8, 172.16/12, 192.168/16) 요청을 받는다. 기본값은 루프백 전용.
# 운영 PC에서만 켜고, 함께 `npm run site:start:lan` 으로 0.0.0.0 바인딩해야 한다.
# 주의: API에는 인증이 없으므로 포트 3000에 닿는 사람은 전체 데이터를 읽을 수 있다.
RND_ALLOW_LAN="0"

# 사설 IP가 아닌 호스트명(예: 사내 DNS 이름)으로 접속해야 할 때만 쉼표로 나열.
# RND_ALLOW_LAN=1 일 때만 적용된다. 예: "rnd-pc,rnd-pc.local"
RND_ALLOWED_LAN_HOSTS=""
